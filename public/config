// /api/admin/config (somente administradores)
// AJUSTE: SESSION_COOKIE deve ser o nome do cookie que o seu /api/entrar define.
export const SESSION_COOKIE = "sid";

const json = (obj, status = 200) =>
  new Response(JSON.stringify(obj), {
    status,
    headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
  });

export function lerCookie(req, nome) {
  const m = (req.headers.get("Cookie") || "").match(
    new RegExp("(?:^|;\\s*)" + nome + "=([^;]+)")
  );
  return m ? decodeURIComponent(m[1]) : null;
}

export async function ehAdmin(req, env) {
  const sid = lerCookie(req, SESSION_COOKIE);
  if (!sid) return false;
  const agora = Math.floor(Date.now() / 1000);
  const row = await env.DB.prepare(
    `SELECT u.is_admin AS adm
       FROM sessions s JOIN users u ON u.id = s.user_id
      WHERE s.id = ? AND s.expires > ?`
  ).bind(sid, agora).first();
  return !!row && Number(row.adm) === 1;
}

export async function onRequestGet({ request, env }) {
  if (!(await ehAdmin(request, env))) return json({ erro: "Acesso negado." }, 403);
  const row = await env.DB.prepare(
    "SELECT valor FROM config WHERE chave = 'dia_terco_especial'"
  ).first();
  return json({ dia_terco_especial: parseInt(row?.valor ?? "6", 10) });
}

export async function onRequestPut({ request, env }) {
  if (!(await ehAdmin(request, env))) return json({ erro: "Acesso negado." }, 403);
  let body;
  try { body = await request.json(); }
  catch { return json({ erro: "Dados inválidos." }, 400); }
  const dia = body?.dia_terco_especial;
  if (!Number.isInteger(dia) || dia < 0 || dia > 6)
    return json({ erro: "Escolha um dia entre domingo e sábado." }, 400);
  await env.DB.prepare(
    `INSERT INTO config (chave, valor) VALUES ('dia_terco_especial', ?)
     ON CONFLICT(chave) DO UPDATE SET valor = excluded.valor`
  ).bind(String(dia)).run();
  return json({ ok: true, dia_terco_especial: dia });
}
